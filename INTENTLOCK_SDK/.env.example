# INTENTLOCK Environment Configuration Example

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Security Configuration
FAIL_CLOSED=true
DEFAULT_APPROVAL_TIMEOUT_SECONDS=300
ENABLE_AUDIT_LOGGING=true

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_secure_random_string_in_production
CORS_ORIGINS=["http://localhost:3000"]

# Database Configuration (PostgreSQL for backend)
DATABASE_URL=postgresql://intentlock_user:intentlock_password@localhost:5432/intentlock_db

# Redis Configuration (Optional, for caching & ephemeral approval state)
REDIS_URL=redis://localhost:6379/0

# Dashboard Configuration (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

